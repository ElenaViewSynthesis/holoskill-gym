#!/usr/bin/env python3
"""Fail when generated artifacts contain credential values or secret shapes."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from holoskill_gym.privacy import scan_artifact_tree

SECRET_ENV_VARS = (
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "HAI_API_KEY",
    "OPENROUTER_API_KEY",
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--env-file", default=".env")
    args = parser.parse_args(argv)
    _load_secret_environment(args.env_file)
    secrets = [os.environ[name] for name in SECRET_ENV_VARS if os.environ.get(name)]
    failed = False
    for root in args.paths:
        findings = scan_artifact_tree(root, known_secret_values=secrets)
        for relative in findings:
            print(f"secret-shaped artifact: {root / relative}")
            failed = True
    return int(failed)


def _load_secret_environment(env_file: str) -> None:
    path = Path(env_file)
    if not path.is_absolute():
        path = ROOT / path
    if not path.is_file():
        return
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        os.environ.setdefault(name.strip(), value.strip().strip('"').strip("'"))


if __name__ == "__main__":
    raise SystemExit(main())
