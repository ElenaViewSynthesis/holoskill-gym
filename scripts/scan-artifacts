#!/usr/bin/env python3
"""Fail when generated artifacts contain credential values or secret shapes."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from holoskill_gym.privacy import load_known_secret_values, scan_artifact_tree


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--env-file", default=".env")
    args = parser.parse_args(argv)
    env_file = Path(args.env_file)
    if not env_file.is_absolute():
        env_file = ROOT / env_file
    secrets = load_known_secret_values(env_file)
    failed = False
    for root in args.paths:
        findings = scan_artifact_tree(root, known_secret_values=secrets)
        for relative in findings:
            print(f"secret-shaped artifact: {root / relative}")
            failed = True
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
