#!/usr/bin/env python3
"""Render all checked-in Harbor canary verifiers from one strict template."""

from __future__ import annotations

import argparse
from pathlib import Path
from string import Template

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data" / "holoskill-codeopt-v1"
TEMPLATE = Template((DATA / "verifier.py.tmpl").read_text(encoding="utf-8"))
TASKS = {
    "observer/codeopt-train-001": (
        "src/prefix_cache.py",
        "encode_throughput_units",
        "maximize",
    ),
    "observer/codeopt-train-002": (
        "src/batching.py",
        "scoring_throughput_units",
        "maximize",
    ),
    "observer/codeopt-val-001": (
        "src/serialization.py",
        "serialize_latency_units",
        "minimize",
    ),
    "observer/codeopt-test-001": (
        "src/locking.py",
        "read_latency_units",
        "minimize",
    ),
    "private_gate/codeopt-gate-001": (
        "src/allocation.py",
        "buffer_latency_units",
        "minimize",
    ),
}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--check",
        action="store_true",
        help="Fail if a checked-in verifier differs from the shared template.",
    )
    args = parser.parse_args(argv)
    stale: list[Path] = []
    for relative, (module, metric, direction) in TASKS.items():
        task_id = relative.rsplit("/", 1)[-1]
        rendered = TEMPLATE.substitute(
            TASK_ID=task_id,
            MODULE=module,
            METRIC=metric,
            DIRECTION=direction,
        )
        destination = DATA / relative / "tests" / "verify.py"
        if args.check:
            if not destination.is_file() or destination.read_text(encoding="utf-8") != rendered:
                stale.append(destination)
            continue
        destination.write_text(rendered, encoding="utf-8", newline="\n")
        print(destination.relative_to(ROOT))
    if stale:
        for destination in stale:
            print(f"stale: {destination.relative_to(ROOT)}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
