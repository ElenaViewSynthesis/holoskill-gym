#!/usr/bin/env bash
# Apply HoloSkill Gym's patches to the pinned vendored checkouts.
#
# Submodules record a commit SHA, not file contents, so a local edit inside
# reference/ cannot be committed by this repository and would be lost on a
# fresh clone. Patches live here instead and are re-applied after
# `git submodule update`.
#
# Idempotent: an already-applied patch is detected and skipped, so running
# this twice is safe.
#
# Usage: bash scripts/apply-vendor-patches [--check]
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
check_only=0
[[ "${1:-}" == "--check" ]] && check_only=1

# Vendored checkouts do not pin line endings, so a LF patch must still
# match a CRLF working tree on Windows.
APPLY_FLAGS="--ignore-whitespace"

status=0
apply_patch() {
  local submodule="$1" patch="$2"
  local target="$repo_root/$submodule"
  local patch_path="$repo_root/patches/$patch"

  if [[ ! -d "$target" ]]; then
    echo "SKIP  $submodule is not initialized; run git submodule update --init --recursive" >&2
    status=1
    return
  fi

  if git -C "$target" apply --reverse --check $APPLY_FLAGS "$patch_path" 2>/dev/null; then
    echo "OK    $patch already applied to $submodule"
    return
  fi

  if ! git -C "$target" apply --check $APPLY_FLAGS "$patch_path" 2>/dev/null; then
    echo "FAIL  $patch does not apply cleanly to $submodule" >&2
    echo "      The pin may have moved, or the fix may have landed upstream." >&2
    status=1
    return
  fi

  if (( check_only )); then
    echo "TODO  $patch is not applied to $submodule"
    status=1
    return
  fi

  git -C "$target" apply $APPLY_FLAGS "$patch_path"
  echo "OK    applied $patch to $submodule"
}

apply_patch reference/seagym seagym-redaction-usage-keys.patch
apply_patch reference/seagym seagym-final-resume-idempotence.patch

# Docker copies executable scripts byte-for-byte. On Windows-backed clones,
# core.autocrlf may convert Harbor's POSIX egress-sidecar scripts to CRLF even
# though the pinned Git blobs are LF. The resulting container exits 127 before
# any task starts because `/bin/sh\r` does not exist. Normalize only these two
# executable runtime files and make --check fail if the repair is missing.
normalize_lf_runtime_script() {
  local relative_path="$1"
  local target="$repo_root/reference/seagym/reference/harbor/$relative_path"

  if [[ ! -f "$target" ]]; then
    echo "SKIP  Harbor runtime script is missing: $relative_path" >&2
    status=1
    return
  fi
  if ! grep -q $'\r$' "$target"; then
    echo "OK    Harbor runtime script uses LF: $relative_path"
    return
  fi
  if (( check_only )); then
    echo "TODO  Harbor runtime script requires LF normalization: $relative_path"
    status=1
    return
  fi
  sed -i 's/\r$//' "$target"
  echo "OK    normalized Harbor runtime script to LF: $relative_path"
}

normalize_lf_runtime_script \
  src/harbor/environments/docker/harbor-docker-egress-control-sidecar/entrypoint.sh
normalize_lf_runtime_script \
  src/harbor/environments/docker/harbor-docker-egress-control-sidecar/bin/network-policy

exit "$status"
