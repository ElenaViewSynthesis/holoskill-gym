{
  "experiment_id": "holoskill_algotune_gated",
  "description": "First SkillOpt-gated canary over external AlgoTune tasks. Codex target, Holo optimizer, private gate on held-out AlgoTune tasks. Network policy is deliberately unset: AlgoTune tasks declare no per-phase mode, so runs are NOT network-contained.",
  "seed": 42,
  "task_dataset": {
    "path": "task_index.json",
    "version": "holoskill-algotune-v1"
  },
  "split_manifest": {
    "path": "split.json",
    "split_id": "holoskill_algotune_canary_v1"
  },
  "schedule": {
    "train_size": 1,
    "val_size": 1,
    "test_size": 1,
    "batch_size": 1,
    "num_epochs": 1,
    "num_updates_per_batch": 1
  },
  "dataloader": {
    "shuffle_train": false,
    "drop_last": false
  },
  "backend": {
    "name": "harbor",
    "env": "docker",
    "n_concurrent": 1,
    "agent_override_timeout_sec": 1200,
    "verifier_override_timeout_sec": 1800
  },
  "baseline": {
    "name": "skillopt_holo",
    "class_path": "holoskill_gym.baseline:SkillOptHoloBaseline",
    "config": {
      "initial_skill_path": "../holo_skillopt_matrix/skills/initial_skill.md",
      "skillopt_gate_path": "skillopt_gate.json",
      "split_manifest_path": "split.json",
      "optimizer_backend": "holo_openai_compatible",
      "optimizer_model": "holo3-1-35b-a3b",
      "optimizer_max_attempts": 6,
      "optimizer_initial_backoff_seconds": 6.0,
      "optimizer_max_backoff_seconds": 30.0,
      "gate_mode": "on",
      "gate_metric": "correctness_gated_performance",
      "gate_no_regression": true,
      "target_executor": "codex_exec"
    }
  },
  "rollout_agent": {
    "name": "algotune-codeopt",
    "class_path": "holoskill_gym.algotune:AlgoTuneRolloutAgent",
    "config": {
      "executor": "codex_exec",
      "model_ref": "rollout_model",
      "reasoning_effort": "medium",
      "n_attempts": 1,
      "attempt_modes": ["train"],
      "raw_log_retention": "none"
    },
    "models": {
      "rollout_model": {
        "model": "gpt-5.6-sol",
        "api_base": "https://api.openai.com/v1",
        "api_key_env": "OPENAI_API_KEY",
        "exports": {
          "OPENAI_API_KEY": "{api_key}",
          "OPENAI_BASE_URL": "{api_base}"
        }
      }
    }
  },
  "evaluation_strategy": {
    "update_validation": {
      "source_split": "val",
      "selection": "fixed_subset",
      "val_size": 1
    },
    "replay": {
      "enabled": false,
      "frequency": 1,
      "source": "seen_train_tasks",
      "selection": "fixed_subset",
      "replay_size": 0
    },
    "final_test_views": [
      {"name": "id_test", "source_split": "test"}
    ]
  },
  "metrics": {
    "primary": [
      "success_rate",
      "final_gain",
      "correct_speedup_geomean",
      "algotune_score",
      "candidate_acceptance_rate",
      "reliability_rates",
      "role_separated_spend"
    ],
    "cost": [],
    "registry": [
      {"name": "correct_speedup_geomean", "type": "python", "import_path": "holoskill_gym.report_metrics:CorrectSpeedupGeomeanMetric"},
      {"name": "algotune_score", "type": "python", "import_path": "holoskill_gym.report_metrics:AlgoTuneScoreMetric"},
      {"name": "candidate_acceptance_rate", "type": "python", "import_path": "holoskill_gym.report_metrics:CandidateAcceptanceRateMetric"},
      {"name": "reliability_rates", "type": "python", "import_path": "holoskill_gym.report_metrics:ReliabilityRatesMetric"},
      {"name": "role_separated_spend", "type": "python", "import_path": "holoskill_gym.report_metrics:RoleSeparatedSpendMetric"}
    ]
  },
  "output": {
    "run_dir": "../../results/runs/holoskill_algotune_gated"
  }
}
