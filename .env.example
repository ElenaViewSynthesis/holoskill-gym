# Copy to .env and fill in. Never commit .env.
HAI_API_KEY=

HOLO_BASE_URL=https://api.hcompany.ai/v1/

# Optimizer model for SkillOpt proposals.
# holo3-122b-a10b is the eventual target but requires paid credits
# (HTTP 402 insufficient_credit); the free tier serves holo3-1-35b-a3b.
HOLO_OPTIMIZER_MODEL=holo3-1-35b-a3b

CODEX_EXECUTABLE=codex
CLAUDE_CODE_EXECUTABLE=claude
