# Copy to .env and fill in. Never commit .env.
HAI_API_KEY=

HOLO_BASE_URL=https://api.hcompany.ai/v1/

# Optimizer model for SkillOpt proposals.
# This integration intentionally supports one Holo model for reproducibility.
HOLO_OPTIMIZER_MODEL=holo3-1-35b-a3b

CODEX_EXECUTABLE=codex
CLAUDE_CODE_EXECUTABLE=claude

# DeepSeek (OpenAI-compatible endpoint: https://api.deepseek.com)
# Unused until an executor or optimizer is wired to it.
DEEPSEEK_API_KEY=

# OpenAI (rollout-agent executor target)
# gpt-5.6-sol: 1,050,000 context / 128,000 max output; reasoning effort
# supports none|low|medium|high|xhigh|max (default medium).
OPENAI_API_KEY=
# Project id (proj_...) and optional org id, from
# platform.openai.com/settings/organization/projects
# The OpenAI SDK reads both from the environment with no code change.
OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
# Applies to the OpenAI target only. Pass it per call; never set
# SkillOpt's process-wide reasoning effort, which would also reach Holo.
OPENAI_REASONING_EFFORT=medium

# Anthropic (Claude Code target in the production matrix)
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI-compatible aggregator: https://openrouter.ai/api/v1)
# Keys are minted at https://openrouter.ai/settings/keys and start with sk-or-v1-.
# Unused until an executor or optimizer is wired to it; the Holo optimizer role
# is 35B-only and does not route through here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter uses for its rankings.
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_X_TITLE=

# OpenRouter optimizer (alternative to Holo; optimizer_backend: "openrouter").
# GPT-5.6 Luna is the default and the only model probed that returns a valid
# SkillUpdateProposal. It is paid: $0.20/M prompt, $1.20/M completion.
# z-ai/glm-5.2:free is selectable for a zero-cost run but has never completed
# a proposal. Sampling parameters are CLI arguments, not environment settings.
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Daytona (cloud execution provider for Harbor; alternative to local Docker).
# Either DAYTONA_API_KEY alone, or both DAYTONA_JWT_TOKEN and
# DAYTONA_ORGANIZATION_ID. Unused until a Daytona run is staged.
# DAYTONA_API_URL is read by the Daytona SDK, not by Harbor; the value below is
# the SDK default. Override it for a self-hosted control plane. Do not use
# DAYTONA_SERVER_URL, which the SDK accepts but warns is deprecated.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_JWT_TOKEN=
# DAYTONA_ORGANIZATION_ID=
# DAYTONA_TARGET=
