diff --git a/seagym/logging/redaction.py b/seagym/logging/redaction.py
index daa4fe8..066dc96 100644
--- a/seagym/logging/redaction.py
+++ b/seagym/logging/redaction.py
@@ -4,11 +4,37 @@ from __future__ import annotations
 
 from typing import Any
 
+# Token *counts* are telemetry, not credentials, but every one of these names
+# contains "TOKEN" and so matches sensitive_key(). Redacting them silently
+# replaced integers with "<redacted>" in run artifacts. The set mirrors the
+# token keys seagym/costs.py already recognizes, so the two stay in step.
+_NUMERIC_USAGE_KEYS = {
+    "cache_read_tokens",
+    "cache_tokens",
+    "cached_tokens",
+    "completion_tokens",
+    "input_tokens",
+    "n_cache_tokens",
+    "n_input_tokens",
+    "n_output_tokens",
+    "n_total_tokens",
+    "output_tokens",
+    "prompt_tokens",
+    "tokens",
+    "total_tokens",
+}
+
 
 def redact_sensitive(value: Any) -> Any:
     if isinstance(value, dict):
         return {
-            key: ("<redacted>" if sensitive_key(str(key)) else redact_sensitive(item))
+            key: (
+                item
+                if _numeric_usage_field(key, item)
+                else "<redacted>"
+                if sensitive_key(str(key))
+                else redact_sensitive(item)
+            )
             for key, item in value.items()
         }
     if isinstance(value, list):
@@ -29,6 +55,14 @@ def sensitive_key(key: str) -> bool:
     return any(token in upper for token in ("API_KEY", "TOKEN", "SECRET", "PASSWORD", "AUTH"))
 
 
+def _numeric_usage_field(key: Any, value: Any) -> bool:
+    return (
+        str(key).lower() in _NUMERIC_USAGE_KEYS
+        and isinstance(value, int | float)
+        and not isinstance(value, bool)
+    )
+
+
 def redact_url(value: str) -> str:
     if not value or "@" not in value:
         return value
